# ─── LLM (CLAUDE.md §6) ───
# Default stack: Kimi K2.6 (free) via OpenRouter.
LLM_MODEL=moonshotai/kimi-k2.6:free
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_key_here
# Optional cloud fallbacks:
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Zero-key local alternative (set llm.provider/fallback_chain to "ollama"):
# LLM_BASE_URL=http://localhost:11434/v1

# ─── JARVIS worker loop (CLAUDE.md §6) ───
AGENT_MAX_TURNS=50
AGENT_BUDGET_USD=5.0

# ─── Execution sandbox (CLAUDE.md §6) ───
SANDBOX_PROVIDER=e2b          # e2b | docker | local
E2B_API_KEY=your_key_here

# ─── Worker swarm ───
SWARM_MAX_WORKERS=10

# ─── Literature / web search (optional, research pipeline) ───
SEARCH_SEMANTIC_SCHOLAR_API_KEY=your-ss-key
SEARCH_SERPER_API_KEY=your-serper-key

# ─── Database ───
DB_URL=sqlite+aiosqlite:///./co_scientist.db
