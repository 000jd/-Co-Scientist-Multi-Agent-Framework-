# ─── Core ───
CO_SCIENTIST__DOMAIN=climate_science
CO_SCIENTIST__DEBUG=false
CO_SCIENTIST__DRY_RUN=false

# ─── LLM ───
CO_SCIENTIST__LLM__PROVIDER=openai
CO_SCIENTIST__LLM__MODEL=gpt-4o
CO_SCIENTIST__LLM__API_KEY=sk-...
CO_SCIENTIST__LLM__EMBEDDING_PROVIDER=openai
CO_SCIENTIST__LLM__EMBEDDING_MODEL=text-embedding-3-small
# CO_SCIENTIST__LLM__EMBEDDING_API_BASE=http://localhost:11434

# ─── Climate Data ───
CO_SCIENTIST__CLIMATE__CDS_API_KEY=your-cds-key
CO_SCIENTIST__CLIMATE__EARTHDATA_USERNAME=your-nasa-username
CO_SCIENTIST__CLIMATE__EARTHDATA_PASSWORD=your-nasa-password
CO_SCIENTIST__CLIMATE__NOAA_CDO_TOKEN=your-noaa-token
CO_SCIENTIST__CLIMATE__ZARR_STORE_PATH=/data/climate_zarr

# ─── Literature Search ───
CO_SCIENTIST__SEARCH__SEMANTIC_SCHOLAR_API_KEY=your-ss-key
CO_SCIENTIST__SEARCH__GOOGLE_SCHOLAR_SERPAPI_KEY=your-serpapi-key
CO_SCIENTIST__SEARCH__SERPER_API_KEY=your-serper-key
CO_SCIENTIST__SEARCH__TINYFISH_API_KEY=your-tinyfish-key

# ─── Database ───
CO_SCIENTIST__DATABASE__URL=sqlite+aiosqlite:///./co_scientist.db

# ─── Docker Sandbox ───
CO_SCIENTIST__AGENTS__DOCKER_MEMORY_LIMIT=2g
CO_SCIENTIST__AGENTS__DOCKER_TIMEOUT_SECONDS=300
